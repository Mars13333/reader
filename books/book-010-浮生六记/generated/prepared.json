      ],
      "narrationDurationSeconds": 38.50416666666667,
      "narrationStartFrame": 15265,
      "narrationEndFrame": 16420,
      "startFrame": 15265,
      "durationInFrames": 1167
    },
    {
      "id": "s16",
      "section": "把古人的故事带回今天",
      "kicker": "深情需要四个支点",
      "narration": "换到今天，我会把这段婚姻拆成四个支点。第一，共同生活：两个人要有不靠消费攀比的快乐。第二，经济缓冲：不替超出承受力的人情债担保，也为疾病和失业留出余地。第三，家庭边界：谁作决定、谁传话、谁承担后果，要说清楚。第四，求助机制：朋友的善意很珍贵，但长期照护不能只靠临时借钱。沈复和陈芸最值得珍惜的，是他们真能一起创造生活；最值得警惕的，是他们把太多风险留给深情硬扛。",
      "sourceRefs": [
        {
          "label": "共同生活与经济风险的原文依据",
          "lines": "55，103-109，117，129-153"
        }
      ],
      "narrationDurationSeconds": 38.43245833333334,
      "narrationStartFrame": 16432,
      "narrationEndFrame": 17585,
      "startFrame": 16432,
      "durationInFrames": 1166
    },
    {
      "id": "s17",
      "section": "必须保留的距离",
      "kicker": "动人不等于完整",
      "narration": "不过，这本书不能被直接当成理想婚姻说明书。当前绑定文本的目录和正文只列出闺房、闲情、坎坷、浪游四记，没有出现的内容，我们不能替原文补写。更重要的是，叙述主要来自沈复。陈芸的愿望、委屈和选择，多由丈夫转述；我们能看见她的才情，也要看见她受制于当时的家族秩序和女性行动边界。沈复会反省自己的多情与失责，却也会用宿命解释悲剧。感动可以保留，判断仍要留一段距离。",
      "sourceRefs": [
        {
          "label": "绑定文本四章目录",
          "lines": "1-7，13，77，115，175"
        },
