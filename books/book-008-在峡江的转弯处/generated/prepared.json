      "durationInFrames": 929
    },
    {
      "id": "s08",
      "section": "勇敢也需要后援",
      "kicker": "霞替他承担失去",
      "narration": "陈行甲后来敢于一次次转弯，也不是只靠个人意志。爱人霞当年放弃广东的工作，坐着九曲十八弯的长途车走进山区和他成家。多年后，面对巴东的风险，霞又告诉他：我们本来一无所有，大不了再回下湾村，你种田，我做饭。她不是在喊口号，而是在明确告诉他，失去职位和收入的后果，我愿意一起承担。勇敢背后，往往站着具体的人。",
      "sourceRefs": [
        {
          "label": "霞进山成家",
          "lines": "508-520"
        },
        {
          "label": "霞支持他承担风险",
          "lines": "554-568"
        }
      ],
      "narrationDurationSeconds": 31.792875,
      "narrationStartFrame": 6017,
      "narrationEndFrame": 6971,
      "startFrame": 6017,
      "durationInFrames": 967
    },
    {
      "id": "s09",
      "section": "巴东先给了他一堵墙",
      "kicker": "不信任扑面而来",
      "narration": "二〇一一年到巴东上任，迎接他的不是英雄舞台。网上有五千字公开信，邮箱每天涌来几十封意见；大楼门口常有成群上访者，有人下跪、抱腿、撞柱；他的私人手机号被人扩散，半夜也有人打来骂他连下水道都管不好。更危险的是，有干部在背后等着看新书记被群众拖垮。这个地方真正的难题，是老百姓不得不找政府，却已经不再相信政府。",
      "sourceRefs": [
        {
          "label": "公开信与网络民意",
          "lines": "938-948"
        },
        {
          "label": "围堵上访与手机号扩散",
          "lines": "950-960"
        }
      ],
      "narrationDurationSeconds": 30.636,
      "narrationStartFrame": 6984,
      "narrationEndFrame": 7903,
      "startFrame": 6984,
      "durationInFrames": 931
    },
    {
      "id": "s10",
      "section": "他先被压力击倒",
      "kicker": "抑郁不是软弱",
      "narration": "陈行甲试图硬扛，结果连续失眠、食欲下降、身体消瘦，最后连安眠药也无法让他入睡。他梦见去世的母亲在门外喊乳名，醒来后给霞打电话，说自己病了。霞马上安排请假、转院和陪护；住院十七天后，他才从崩溃边缘回来。出院后又按医生要求长期服药，直到真正稳定。原文在这里提醒我们：理想主义者也会生病，专业治疗不能被意志论代替。",
      "sourceRefs": [
        {
          "label": "重度焦虑抑郁与住院康复",
          "lines": "542-550"
        },
        {
          "label": "巴东压力背景",
          "lines": "960-962"
        }
      ],
      "narrationDurationSeconds": 33.77316666666667,
      "narrationStartFrame": 7915,
      "narrationEndFrame": 8929,
      "startFrame": 7915,
      "durationInFrames": 1026
    },
    {
      "id": "s11",
      "section": "不再责怪刁民",
      "kicker": "追问怨气从哪里来",
      "narration": "康复后，他没有把困局简单归咎于“刁民”。他复盘邓玉娇事件，又走进贫困户、艾滋病患者和偏远学校，看到的是腐败的干部作风、漫长难行的道路，以及大病和贫困把人逼到绝境。于是他得出结论：老百姓的怨气，是坏作风逼出来的，是崎岖山路颠出来的，也是封闭贫困憋出来的。解释一变，治理方法才可能跟着变。",
      "sourceRefs": [
        {
          "label": "复盘作风与信任危机",
          "lines": "970-974"
        },
        {
          "label": "贫困、疾病与道路困境",
          "lines": "976-984"
        }
      ],
      "narrationDurationSeconds": 31.111958333333334,
      "narrationStartFrame": 8941,
      "narrationEndFrame": 9874,
      "startFrame": 8941,
      "durationInFrames": 946
    },
    {
      "id": "s12",
      "section": "先让干部看见人",
      "kicker": "与小航结穷亲",
      "narration": "他的第一步，是号召干部结穷亲。他自己选择满身红疮、被村民躲着走的艾滋病患儿小航，承诺“只要我还在，只要他还在”。那年除夕，他去小航家吃团年饭。对其他干部，他不规定送多少钱，却要求一年至少入户三次、住一晚。这样的关系不能替代公共政策，但能先刺破报表，让决策者亲眼看见政策对象如何吃饭、睡觉和等待。",
      "sourceRefs": [
        {
          "label": "小航与干部结穷亲",
          "lines": "977-990"
        }
      ],
      "narrationDurationSeconds": 34.12504166666667,
      "narrationStartFrame": 9887,
      "narrationEndFrame": 10911,
      "startFrame": 9887,
      "durationInFrames": 1036
    },
    {
      "id": "s13",
      "section": "再把善意写进规则",
      "kicker": "不认识书记也能办事",
      "narration": "更关键的一步，是把个人愿望变成制度。巴东设置行政时钟，承诺期限内办不完就追责；五千多场屋场院子会，让村民当面评谁是真贫困户；第三方再随机打出数万通电话，让群众评价乡镇干部的德、能、勤、绩、廉，满意度太低就不能提拔。一个地方不能永远等好书记出现。真正可靠的改变，是普通人不认识书记，也有记录、申诉和评价的权利。",
      "sourceRefs": [
        {
          "label": "限时办结与屋场院子会",
          "lines": "1000-1002"
        },
        {
          "label": "群众评价干部",
          "lines": "1003-1006"
        }
      ],
      "narrationDurationSeconds": 35.90154166666667,
      "narrationStartFrame": 10923,
      "narrationEndFrame": 12000,
      "startFrame": 10923,
      "durationInFrames": 1090
    },
    {
      "id": "s14",
      "section": "规则开始反咬利益",
      "kicker": "威胁打到了家人",
      "narration": "制度碰到工程利益，反击很快来了。四千五百万元修建的河堤被不大的涨水冲垮，调查受到层层阻挠。有人知道他住哪里，也有人给霞打电话，准确说出她的单位和儿子的学校。陈行甲连夜重写纪委全会讲话，把暗处的威胁公开到会场。后来他签字查办大批官员和不法商人。这里的代价不是一句“虽千万人吾往矣”，而是家人安全、个人前途和再次患病的风险。",
      "sourceRefs": [
        {
          "label": "家人遭威胁与公开宣战",
          "lines": "556-564"
        },
        {
          "label": "河堤工程与查办结果",
          "lines": "1046-1090"
        }
      ],
      "narrationDurationSeconds": 35.42808333333333,
      "narrationStartFrame": 12013,
      "narrationEndFrame": 13076,
      "startFrame": 12013,
      "durationInFrames": 1076
    },
    {
      "id": "s15",
      "section": "荣誉不是离开的理由",
      "kicker": "他曾请求留下",
      "narration": "二〇一五年，他获评全国优秀县委书记。省委领导流露出重用之意，他却连夜写信，请求让自己继续留在巴东直到换届，因为助养贫困儿童、农村信息服务等工作还没有做完。他说，宁愿行政生涯的顶点就是县委书记，也想把这份工作做到极致。所以后来的辞职并不是厌倦基层，更不是用离开证明从政无意义；恰恰是做完一届之后，重新选择服务方式。",
      "sourceRefs": [
        {
          "label": "全国优秀县委书记荣誉",
          "lines": "1092-1100"
        },
        {
          "label": "请求留任完成工作",
          "lines": "1102-1116"
        }
      ],
      "narrationDurationSeconds": 33.528666666666666,
      "narrationStartFrame": 13089,
      "narrationEndFrame": 14094,
      "startFrame": 13089,
      "durationInFrames": 1018
    },
    {
      "id": "s16",
      "section": "峡江真正的转弯",
      "kicker": "方向不变，路线可以变",
      "narration": "真正把决定想清楚，是在大面山顶。滚滚长江被山体挡住，向右急转九十度，再进入开阔江面。他由此想到，追求理想的灵魂像奔向大海的河流，方向不变，却要绕开漩涡和暗礁。于是他决定任期结束后辞职，以普通党员身份反映基层行政问题，再去公益领域服务弱者。这不是“世界太坏，所以我走了”，而是“目标仍在，我换一条能继续前进的河道”。",
      "sourceRefs": [
        {
          "label": "大面山俯瞰长江转弯",
          "lines": "1120-1124"
        },
        {
          "label": "辞职、上书与转场",
          "lines": "1123-1126"
        }
      ],
      "narrationDurationSeconds": 34.53941666666667,
      "narrationStartFrame": 14107,
      "narrationEndFrame": 15143,
      "startFrame": 14107,
      "durationInFrames": 1049
    },
    {
      "id": "s17",
      "section": "公益也要做实验",
      "kicker": "从救一个人到改一套系统",
      "narration": "转入公益后，他没有满足于讲苦难、募一笔钱、救一个人。联爱工程选择河源儿童白血病做小范围试点：一边把患儿目录内报销比例提高到九成，一边帮助当地医院建立儿童血液科，还委托大学做药物评估，把结果交给医保部门。这个思路像一块试验田，用有限资源验证流程、沉淀数据，再推动更大的公共系统改善。共情到这里，才被翻译成可以复制的方法。",
      "sourceRefs": [
        {
          "label": "因病致贫与联爱工程设计",
          "lines": "1206-1220"
        },
        {
          "label": "河源试点结果与药物评估",
          "lines": "1222-1226"
        }
      ],
      "narrationDurationSeconds": 32.20283333333333,
      "narrationStartFrame": 15156,
      "narrationEndFrame": 16122,
      "startFrame": 15156,
      "durationInFrames": 978
    },
    {
      "id": "s18",
      "section": "仍然会有接不住的人",
      "kicker": "小乐没有回来",
      "narration": "但专业化也不等于万能。抑郁症少年小乐住院时，陈行甲和霞专程探望，凭自己的康复经验陪他散步、协助和医生沟通。孩子一度好转，去上大学，还在微信里为陈叔叔加油。两年后，噩耗传来，小乐在学校自杀。陈行甲由此发起知更鸟计划，希望连接医院、学校和公益组织。这个失败很重要：一次温暖的会面、一次短期好转，都不能被误认为长期康复。",
      "sourceRefs": [
        {
          "label": "探望并陪伴小乐",
          "lines": "1282-1296"
        },
        {
          "label": "小乐去世与知更鸟计划",
          "lines": "1298-1306"
        }
      ],
      "narrationDurationSeconds": 34.899625,
      "narrationStartFrame": 16134,
      "narrationEndFrame": 17181,
      "startFrame": 16134,
      "durationInFrames": 1060
    },
    {
      "id": "s19",
      "section": "小电驴要给列车让道",
      "kicker": "公益的边界",
      "narration": "新冠疫情中，恒晖先补防护物资，随后支援医疗队生活，再转向滞留人员和困境群体；当政府保障全面接手，他们就退出。陈行甲把国家队比作大列车，把公益组织比作小电驴：小电驴启动快，可以先补缺口，但列车提速后就该让开主道。这个比喻也适用于所有理想主义行动——帮助不是抢占舞台，组织的价值，是在最需要的环节出现，也在任务完成时退场。",
      "sourceRefs": [
        {
